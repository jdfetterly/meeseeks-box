<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jd.meeseeks-box</string>

  <key>WorkingDirectory</key>
  <string>/Users/agent-playground/code/repos/meeseeks-box</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>npm run start -- --hostname 127.0.0.1 --port 3001</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>

  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/agent-playground/Library/Logs/meeseeks-box.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/agent-playground/Library/Logs/meeseeks-box.err.log</string>
</dict>
</plist>
