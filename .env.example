# =============================================================================
# ClawPort — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# See SETUP.md for detailed instructions on finding each value.
# =============================================================================

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Path to your OpenClaw workspace directory.
# Default location: ~/.openclaw/workspace
# Find yours: ls ~/.openclaw/workspace
WORKSPACE_PATH=/Users/yourname/.openclaw/workspace

# Path to the openclaw CLI binary.
# Find yours: which openclaw
OPENCLAW_BIN=/usr/local/bin/openclaw

# OpenClaw gateway authentication token.
# All API calls (chat, vision, TTS, transcription) use this token.
# Find yours: openclaw gateway status
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here

# Optional runtime bind host for `clawport dev` and `clawport start`.
# Default is loopback-only (`127.0.0.1`) to preserve Tailnet-only exposure.
# CLAWPORT_HOST=127.0.0.1

# Optional comma-separated allowlist for Next.js dev origins.
# Leave unset to allow only localhost/127.0.0.1 origins.
# Example for explicit Tailnet access:
# CLAWPORT_ALLOWED_DEV_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://your-tailnet-host

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# ElevenLabs API key — enables voice indicators on agent profiles.
# Get one at: https://elevenlabs.io
# Leave blank or remove this line if you don't need voice features.
# ELEVENLABS_API_KEY=sk_your-elevenlabs-key-here

# Optional override for the canonical product-state store location.
# Defaults to <repo>/.meeseeks-box/state.sqlite.
# MEESEEKS_BOX_STATE_DIR=/absolute/path/to/state-dir

# Base URL used by helper scripts such as:
#   npm run report-schedule-output -- --schedule <id> --file <path> ...
# Set this when jobs need to call back into a non-default Meeseek Box origin.
# MEESEEKS_BOX_BASE_URL=http://127.0.0.1:3000

# Enable runtime-native one-shot schedule sync.
# Leave false in local development unless you have explicitly configured either
# local OpenClaw execution or the narrow SSH bridge below.
# MEESEEKS_BOX_RUNTIME_SCHEDULE_SYNC_ENABLED=false

# Runtime sync mode:
# - local: use OPENCLAW_BIN on the host running Meeseek Box
# - ssh:   create one-shot cron jobs on the mini through a restricted SSH hop
# If unset, Meeseek Box will prefer ssh when the SSH variables are present,
# otherwise local when OPENCLAW_BIN is present.
# MEESEEKS_BOX_OPENCLAW_SYNC_MODE=local

# Optional SSH bridge for development or remote control when Meeseek Box is not
# running on the mini itself.
# MEESEEKS_BOX_OPENCLAW_SSH_HOST=100.105.238.17
# MEESEEKS_BOX_OPENCLAW_SSH_USER=agent-playground
# MEESEEKS_BOX_OPENCLAW_SSH_KEY_PATH=/Users/yourname/.ssh/id_ed25519
# MEESEEKS_BOX_OPENCLAW_REMOTE_BIN=/opt/homebrew/bin/openclaw

# Narrow Slack fallback. Keep disabled unless you explicitly want degraded-mode
# alerts for approval-required items, no-retry failures, and high-signal
# missed schedules.
# MEESEEKS_BOX_SLACK_FALLBACK_ENABLED=false
# MEESEEKS_BOX_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Set to false only if you need to temporarily hide the new canonical state APIs
# while the runtime adapter work is in progress.
# NEXT_PUBLIC_ENABLE_PRODUCT_STATE_API=true
